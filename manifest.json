{
  "manifest_version": 3,
  "name": "Clever Youtube Subtitle",
  "version": "1.8.2",
  "description": "Hide words you know in YouTube captions. Hover to see or change them.",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "My Vocabulary",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["lemma-bundle.js", "word-utils.js", "content.js"],
      "css": ["captions.css"],
      "run_at": "document_idle"
    }
  ]
}
